// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
	"name": "Quantar Breakout Board Dev",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:alpine3.23",
	"features": {
		"ghcr.io/devcontainers/features/nix:1": {
			"multiUser": true,
			"version": "latest",
			"packages": "nixd,nixfmt",
			"extraNixConfig": "experimental-features = nix-command flakes",
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"jnoortheen.nix-ide",
				"mhutchie.git-graph",
			],
			"settings": {
				"nix.enableLanguageServer": true,
			}
		}
	},
	// Enable X11 forwarding for GUI apps like KiCad
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}"
	},
	"runArgs": [
		"--net=host",
		"-v",
		"/tmp/.X11-unix:/tmp/.X11-unix:rw",
		"-v",
		"${localEnv:HOME}/.Xauthority:/home/vscode/.Xauthority:rw"
	],
	// The first time the dev container runs, install the flake's packages
	"postCreateCommand": "nix profile add .",
}
