// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
	"name": "Quantar Breakout Board Dev",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:alpine3.23",
	"features": {
		"ghcr.io/devcontainers/features/nix:1": {
			"multiUser": true,
			"version": "latest",
			"packages": "nixd,nixfmt",
			"extraNixConfig": "experimental-features = nix-command flakes",
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"jnoortheen.nix-ide",
				"mhutchie.git-graph",
			],
			"settings": {
				"nix.enableLanguageServer": true,
			}
		}
	},
	// Forward ports for noVNC (web VNC client) and VNC server
	"forwardPorts": [
		6080,
		5900
	],
	"portsAttributes": {
		"6080": {
			"label": "noVNC - KiCad in Browser",
			"onAutoForward": "notify"
		},
		"5900": {
			"label": "VNC Server",
			"onAutoForward": "ignore"
		}
	},
	// The first time the dev container runs, install the flake's packages
	"postCreateCommand": "nix profile add .",
	// Start VNC server on container start
	// "postStartCommand": "start-vnc",
	// Add scripts to PATH
	"remoteEnv": {
		"PATH": "${containerEnv:PATH}:/workspaces/quantar-breakout-pcb/.devcontainer/scripts"
	},
}
